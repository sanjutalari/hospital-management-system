# ============================================================
# HMS Frontend - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values

# ─── Backend API URL ────────────────────────────────────────
# Production: https://your-backend-domain.com/api
# Development: http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# ─── Socket.io URL ──────────────────────────────────────────
# Production: https://your-backend-domain.com
# Development: http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# ─── Production Deployment Notes ────────────────────────────
# 1. Update VITE_API_URL to your deployed backend URL
# 2. Update VITE_SOCKET_URL to your deployed backend URL (without /api)
# 3. Ensure backend URL uses HTTPS in production
