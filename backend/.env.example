# ============================================================
# HMS Backend - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ─── Server Configuration ───────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Frontend URL ───────────────────────────────────────────
# Production: https://your-frontend-domain.com
# Development: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (Supabase): postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Example (Render): postgres://user:pass@dpg-xxxxx.oregon-postgres.render.com/dbname
# Development (SQLite): file:./dev.db
DATABASE_URL="postgresql://postgres:password@localhost:5432/hms_db"

# ─── JWT Secrets ────────────────────────────────────────────
# IMPORTANT: Generate strong random secrets for production!
# Use: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long

# ─── Cloudinary (File Upload) ───────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── OpenAI (AI Health Assistant) - OPTIONAL ───────────────
# Get API key from https://platform.openai.com/api-keys
# Leave empty to use mock responses
OPENAI_API_KEY=

# ─── Logging ────────────────────────────────────────────────
# Logging level: error, warn, info, debug
LOG_LEVEL=info

# ─── Production Deployment Notes ────────────────────────────
# 1. Generate new JWT secrets before deploying
# 2. Use PostgreSQL for production (not SQLite)
# 3. Set real Cloudinary credentials for file uploads
# 4. Add OpenAI API key for real AI features
# 5. Set NODE_ENV=production
# 6. Use HTTPS (automatic on Render/Vercel)
